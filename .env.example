# Copy to .env.local and fill in the real values. .env.local is gitignored;
# this file is committed and must never contain a real key.
#
# Nothing here is NEXT_PUBLIC_. The browser never talks to Supabase: every read
# and write goes through the Next.js server, which is what lets RLS deny all
# public access and makes the group link genuinely act as the password.

# Supabase dashboard > Project Settings > Data API.
SUPABASE_URL=https://your-project.supabase.co

# Dashboard > Project Settings > API keys > secret (starts sb_secret_).
# Bypasses RLS. Server-side only — never prefix this NEXT_PUBLIC_, never log
# it, and set it in Vercel as an encrypted environment variable.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional. Only needed if the browser is ever given direct Supabase access
# (realtime, say), which the current design deliberately avoids.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
